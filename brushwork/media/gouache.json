  "primer": "#f3efe6",
  "ground": "#d6c3ae",
  "scale": {"ridge": 0.45, "furrow": 0.4, "blob": 0.35, "unmix": 0.55, "dry": 0.7, "skip": 0.6, "wobble": 0.8},
  "body": 0.3,
  "render": {"relief": 0.35, "spec": 0.0, "shadow": 0.12, "amb": 0.55, "weave_amp": 0.3, "weave_hide": 0.35, "blur": 0.8}
